# Database (Provided by Railway/Neon/Supabase after deployment)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/texashotel?schema=public"

# JWT - CHANGE THIS TO A LONG RANDOM STRING IN PRODUCTION
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# App
PORT=3001
NODE_ENV=development

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (Optional - for payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Chapa (Optional - for Ethiopia payments)
CHAPA_SECRET_KEY=""

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
